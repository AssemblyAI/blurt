.build/
.swiftpm/
DerivedData/
*.xcuserdatad/
xcuserdata/
.DS_Store
.claude/*
!.claude/settings.json
# Shared, project-specific Claude Code automations (kept under version control).
# Personal config (.claude/settings.local.json) stays ignored by .claude/* above.
!.claude/hooks/
!.claude/agents/
!.claude/skills/
# Hookify rules shared with the repo. hookify only loads files named
# hookify.*.local.md, so these keep the suffix even though they're committed.
!.claude/hookify.*.local.md
.superpowers/
# Per-developer agent scratch notes. A nested .remember/.gitignore is only ever
# local, so name the directory here too — that way a fresh clone ignores it
# without waiting for the tool to recreate it. Also in .prettierignore, so a
# local `prettier --check` doesn't fail on notes CI never sees.
.remember/
build/
docs/

# Code-coverage profiles dropped in the working dir by coverage-instrumented
# test runs (the Blurt.xctestplan enables coverage; the real data lands in the
# .xcresult / .build, these stray zero-byte profiles don't belong in git).
*.profraw
*.profdata

# tools/jscpd's install (npm ci --prefix tools/jscpd); its lockfile is tracked.
tools/jscpd/node_modules/
# The evals' venv (uv sync --project evals --locked); evals/uv.lock is tracked.
evals/.venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage

# Output of the dictation-prompt eval (evals/dictation-prompt). A run's --out JSON
# and its tee'd log hold the corpus text and every model response, so they are
# working notes rather than repo content — quote a number into the PR instead.
results*.json
*.log

# Both apps' projects, Info.plists and entitlements are generated by
# `xcodegen generate` from their project.yml (every script that builds does it
# first, CI included), so none of it is committed: project.yml is the one
# source, and there is no generated copy to drift from it.
App/Blurt/Blurt.xcodeproj/
App/Blurt/Blurt/Info.plist
App/Blurt/Blurt/Blurt.entitlements
App/BlurtiOS/BlurtiOS.xcodeproj/
App/BlurtiOS/*/Info.plist
App/BlurtiOS/*/*.entitlements

# Sign in with AssemblyAI's dev values name AssemblyAI's sandbox deployments,
# which stay out of this public repo (see App/Blurt/Config/SignIn.xcconfig).
App/Blurt/Config/SignIn.local.xcconfig
