.build/
.swiftpm/
DerivedData/
*.xcuserdatad/
xcuserdata/
.DS_Store
.claude/*
!.claude/settings.json
# Shared, project-specific Claude Code automations (kept under version control).
# Personal config (.claude/settings.local.json) stays ignored by .claude/* above.
!.claude/hooks/
!.claude/agents/
!.claude/skills/
.superpowers/
build/
docs/

# Code-coverage profiles dropped in the working dir by coverage-instrumented
# test runs (the Blurt.xctestplan enables coverage; the real data lands in the
# .xcresult / .build, these stray zero-byte profiles don't belong in git).
*.profraw
*.profdata

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Prompt-optimizer run output. The GEPA/eval harness under evals/ writes a
# transcript log and a scored-candidate dump per run, named after the model
# under test (qwen-gepa.log, results-qwen-gepa.json). They are per-run scratch:
# the prompt a run selects gets committed deliberately, the search that found
# it does not.
*.log
results-*.json
