{
  "permissions": {
    "allow": [
      "Bash(swift test *)",
      "Bash(swift build *)",
      "Bash(xcodegen generate *)",
      "Bash(xcodebuild -project App/Blurt/Blurt.xcodeproj -scheme Blurt -configuration Debug -derivedDataPath /tmp/blurt-build build)",
      "Bash(xcrun swift-format *)",
      "Bash(swift-format lint *)",
      "Bash(swiftlint lint *)",
      "Bash(periphery scan *)",
      "Bash(shellcheck scripts/*.sh)",
      "Bash(shellcheck .claude/hooks/*.sh)",
      "Bash(shfmt *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(pytest *)",
      "Bash(mypy *)",
      "Bash(coverage *)",
      "Bash(uv sync --project evals --locked)",
      "Bash(markdownlint *)",
      "Bash(prettier --check *)",
      "Bash(scripts/check.sh)",
      "Bash(./scripts/check.sh)",
      "Bash(scripts/check.sh --portable)",
      "Bash(./scripts/check.sh --portable)",
      "Bash(scripts/check.sh --lint-only)",
      "Bash(./scripts/check.sh --lint-only)",
      "Bash(bash scripts/check-invariants.sh*)",
      "Bash(bash scripts/check-portability.sh*)",
      "Bash(bash scripts/check-release-notes.sh)",
      "Bash(bash scripts/check-swift-size.sh*)",
      "Bash(bash scripts/check-test-clock.sh*)",
      "Bash(bash scripts/design-sync.sh --check)",
      "Bash(bash scripts/mutate.sh --list)",
      "Bash(zizmor *)",
      "Bash(jscpd)",
      "Bash(jscpd *)",
      "Bash(scripts/dev-build.sh)",
      "Bash(scripts/ios-sim.sh*)",
      "Bash(scripts/ios-test.sh*)",
      "Bash(scripts/ios-check.sh*)",
      "Bash(scripts/ios-typecheck.sh*)",
      "Bash(scripts/ios-uitest.sh*)",
      "Bash(scripts/swiftlint-analyze.sh*)",
      "Bash(scripts/mac-static.sh*)",
      "Bash(prettier *)",
      "Bash(actionlint)",
      "Bash(actionlint *)",
      "Bash(xmllint --noout *)",
      "Bash(bash scripts/release.test.sh)",
      "mcp__assemblyai-docs__search_docs",
      "mcp__assemblyai-docs__list_sections",
      "mcp__assemblyai-docs__get_pages",
      "mcp__assemblyai-docs__get_api_reference"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/swift-format.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/swiftlint.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/swift-budgets.sh"
          }
        ]
      }
    ]
  }
}
