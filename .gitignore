.build/
.swiftpm/
DerivedData/
*.xcuserdatad/
xcuserdata/
# XcodeGen output for the iOS link probe. App/Blurt/Blurt.xcodeproj is committed
# (people open it) and drift-checked against its project.yml; this one has no
# human user — CI generates it from App/BlurtiOSShell/project.yml right before it
# builds — so there is nothing to commit and nothing to drift. Named exactly, not
# as a `*.xcodeproj/` glob, which would shadow the tracked mac project.
App/BlurtiOSShell/BlurtiOSShell.xcodeproj/
.DS_Store
.claude/*
!.claude/settings.json
# Shared, project-specific Claude Code automations (kept under version control).
# Personal config (.claude/settings.local.json) stays ignored by .claude/* above.
!.claude/hooks/
!.claude/agents/
!.claude/skills/
.superpowers/
# Per-developer agent scratch notes. A nested .remember/.gitignore is only ever
# local, so name the directory here too — that way a fresh clone ignores it
# without waiting for the tool to recreate it. Also in .prettierignore, so a
# local `prettier --check` doesn't fail on notes CI never sees.
.remember/
build/
docs/

# Code-coverage profiles dropped in the working dir by coverage-instrumented
# test runs (the Blurt.xctestplan enables coverage; the real data lands in the
# .xcresult / .build, these stray zero-byte profiles don't belong in git).
*.profraw
*.profdata

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Output of the dictation-prompt eval (evals/dictation-prompt). A run's --out JSON
# and its tee'd log hold the corpus text and every model response, so they are
# working notes rather than repo content — quote a number into the PR instead.
results*.json
*.log
