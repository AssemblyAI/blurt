#!/bin/bash
# Formats and lints the Markdown a commit stages, so a commit can't carry what
# check.sh's markdownlint and prettier would reject: prettier --write, then
# markdownlint-cli2 --fix, then a lint that fails the commit on anything left.
# The same scope as check.sh: .markdownlint-cli2.jsonc's `ignores` (CLAUDE.md,
# docs/, …), which markdownlint-cli2 applies to the files passed here too.
#
# A file also changed outside the index is linted but not rewritten: fixing it
# would stage the unstaged edits along with the fix. The lint reads what is
# staged, never the working copy, so it judges exactly what is committed. scripts/bootstrap.sh turns
# this on (git config core.hooksPath .githooks); skip once with --no-verify.
set -euo pipefail

files=()
while IFS= read -r file; do
  [ -n "$file" ] && files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.md')
[ "${#files[@]}" -gt 0 ] || exit 0

if ! command -v markdownlint-cli2 >/dev/null 2>&1; then
  echo "pre-commit: markdownlint-cli2 not found — run scripts/bootstrap.sh (skipping the Markdown check)" >&2
  exit 0
fi

fixable=()
for file in "${files[@]}"; do
  if git diff --quiet -- "$file"; then
    fixable+=("$file")
  else
    echo "pre-commit: $file has unstaged changes; linting it, not fixing it" >&2
  fi
done

if [ "${#fixable[@]}" -gt 0 ]; then
  if command -v prettier >/dev/null 2>&1; then
    prettier --write --log-level warn "${fixable[@]}"
  fi
  markdownlint-cli2 --fix "${fixable[@]}" >/dev/null 2>&1 || true
  git add -- "${fixable[@]}"
fi

# The staged copies, beside the repo's lint config, so a partly staged file is
# judged as committed. Quiet when clean; the findings, and only them, when not.
staged="$(mktemp -d)"
trap 'rm -rf "$staged"' EXIT
git checkout-index --prefix="$staged/" -- "${files[@]}"
cp .markdownlint.jsonc .markdownlint-cli2.jsonc "$staged/"
if ! report="$(cd "$staged" && markdownlint-cli2 "${files[@]}" 2>&1)"; then
  printf '%s\n' "$report" | grep -E '^[^ ]+:[0-9]+' >&2 || printf '%s\n' "$report" >&2
  echo "pre-commit: fix the Markdown above, or commit with --no-verify to skip" >&2
  exit 1
fi
